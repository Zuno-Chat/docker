          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(synapse_usage_r30v2_users_all)",
          "legendFormat": "retained"
        }
      ],
      "description": "Retained is Synapse's R30: accounts seen more than once in the last 60 days with over 30 days between the first and last time. Synapse splits it by platform only for Element clients, so the Zuno app is counted here and nowhere else."
    },
