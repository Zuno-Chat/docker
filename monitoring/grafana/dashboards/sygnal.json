  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "zuno"
      ],
      "title": "Zuno",
      "type": "dashboards"
