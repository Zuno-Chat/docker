# Copy to .env on the server and chmod 600 it. Never commit .env.

# Postgres password for the synapse role; Synapse receives it as PGPASSWORD.
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# Optional services, comma-separated. Always on, with or without a profile:
# nginx, postgres, redis, synapse, synapse-sync, synapse-background.
#   push        sygnal                     needs sygnal/service_account.json
#                                          and sygnal/apns_auth_key.p8
#   monitoring  prometheus, grafana,       README.md, Monitoring
#               synapse-usage-exporter
#   events      synapse-event-persister    README.md, Sizing (scaling step 2)
COMPOSE_PROFILES=push

# --- Push ---------------------------------------------------------------------
# This server's public IPs, comma-separated. Synapse delivers pushes to the
# public URL, so they leave through Cloudflare and come back from here; nginx
# refuses the push route to every other address, and does not start without a
# value. (Cloudflare's own ranges are in nginx/cloudflare.conf.)
PUSHER_ALLOWED_CIDRS=

# --- Module secrets -----------------------------------------------------------
# bootstrap.sh writes these to files for Synapse's modules on every start, and
# Synapse does not start while any is empty. Their other settings (IDs, TTLs,
# limits, the sender address) are in synapse/homeserver.yaml.

# zuno_calls: the Cloudflare Calls app secret and the TURN key's API token.
CF_CALLS_APP_SECRET=
CF_TURN_API_TOKEN=

# zuno_register: Brevo transactional email, app.brevo.com > SMTP & API > API
# keys.
BREVO_API_KEY=

# --- Map tiles ----------------------------------------------------------------
# MapTiler API key for nginx's /maps/ route: cloud.maptiler.com > Account >
# API keys. nginx adds it to every tile request and sends the User-Agent
# im.zuno.chat, so restrict the key to that User-Agent at MapTiler. It never
# reaches the app. Letters and digits only; nginx does not start without it.
MAPTILER_API_KEY=

# --- Monitoring (COMPOSE_PROFILES includes monitoring) ------------------------
# Prometheus, Grafana and synapse-usage-exporter (usage totals; it has no
# settings here). No host exporters, no log collection and no error tracker run
# in this stack (README.md, Monitoring).
# Generate: openssl rand -hex 32
GRAFANA_ADMIN_PASSWORD=

# Alerts go to this ntfy topic. No query string. On ntfy.sh anyone who knows a
# topic's name can read it: use a long random name, or a token for a reserved
# topic.
NTFY_URL=https://ntfy.sh/zuno-alerts-CHANGE_ME
NTFY_TOKEN=
