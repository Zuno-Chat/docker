# Copy to .env on the server and chmod 600 it. Never commit .env.

# Postgres password for the synapse role; Synapse receives it as PGPASSWORD.
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# Optional services, comma-separated. Always on, with or without a profile:
# nginx, postgres, redis, mas, synapse, synapse-sync, synapse-background.
#   push        sygnal                     needs sygnal/service_account.json
#                                          and sygnal/apns_auth_key.p8
#   monitoring  prometheus, grafana,       README.md, Monitoring
#               synapse-usage-exporter,
#               node-exporter,
#               postgres-exporter
#   events      synapse-event-persister    README.md, Sizing (scaling step 2)
COMPOSE_PROFILES=push

# --- Module secrets -----------------------------------------------------------
# bootstrap.sh writes these to files for Synapse's modules on every start, and
# Synapse does not start while any is empty. Their other settings (IDs, TTLs,
# limits) are in synapse/homeserver.yaml.

# zuno_calls: the Cloudflare Calls app secret and the TURN key's API token.
CF_CALLS_APP_SECRET=
CF_TURN_API_TOKEN=

# --- Accounts (MAS) -----------------------------------------------------------
# mas/init.sh writes these into MAS's config on every start. Compose does not
# start while any is empty, and init.sh refuses a value holding a quote, a
# backslash or a newline.

# Shared by MAS and every Synapse process (bootstrap.sh writes Synapse's copy),
# and MAS's Postgres role password (mas-db-init sets it on every start). Any
# long random strings, e.g. openssl rand -hex 32.
MAS_SHARED_SECRET=
MAS_POSTGRES_PASSWORD=

# Cloudflare Turnstile on sign-up: dash.cloudflare.com > Turnstile, a widget
# for auth.zuno.chat. The site key is public.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Brevo's SMTP relay, for sign-up codes and password resets:
# app.brevo.com > SMTP & API > SMTP.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# --- Map tiles ----------------------------------------------------------------
# MapTiler API key for nginx's /maps/ route: cloud.maptiler.com > Account >
# API keys. nginx adds it to every tile request and sends the User-Agent
# im.zuno.chat, so restrict the key to that User-Agent at MapTiler. It never
# reaches the app. Letters and digits only; nginx does not start without it.
MAPTILER_API_KEY=

# --- Monitoring (COMPOSE_PROFILES includes monitoring) ------------------------
# Prometheus, Grafana and the exporters (usage totals, the host, Postgres). No
# log collection and no error tracker run in this stack (README.md,
# Monitoring).
# Generate: openssl rand -hex 32
GRAFANA_ADMIN_PASSWORD=

# Password of zuno_monitor, the read-only Postgres role postgres-exporter logs
# in as. postgres-monitor-init creates the role and sets this password on every
# `up`, so changing it here is enough.
# Generate: openssl rand -hex 32
POSTGRES_MONITOR_PASSWORD=

# Alerts go to this ntfy topic. No query string. On ntfy.sh anyone who knows a
# topic's name can read it: use a long random name, or a token for a reserved
# topic.
NTFY_URL=https://ntfy.sh/zuno-alerts-CHANGE_ME
NTFY_TOKEN=
