# Copy to .env on the server and chmod 600 it. Never commit .env.

# Postgres password for the synapse role; Synapse receives it as PGPASSWORD.
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# Optional services, comma-separated. Always on, with or without a profile:
# gateway, postgres, redis, synapse, synapse-sync, synapse-background.
#   push        sygnal                     needs sygnal/service_account.json
#   monitoring  prometheus, grafana,       README.md, Monitoring
#               synapse-usage-exporter
#   events      synapse-event-persister    README.md, Sizing (scaling step 2)
COMPOSE_PROFILES=push

# --- Cloudflare edge ----------------------------------------------------------

# Cloudflare's edge ranges, so the gateway resolves real client IPs for rate
# limits and logs. Source: https://www.cloudflare.com/ips/ (checked 2026-09-17);
# refresh when Cloudflare changes them.
TRUSTED_PROXY_CIDRS=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32

# This server's public IPv4. Synapse delivers pushes to the public URL, so
# they leave through Cloudflare and come back from here. The gateway image
# does not enforce this yet: the Cloudflare WAF rule in README.md is the real
# fence. Compose still refuses to start without a value.
PUSHER_ALLOWED_CIDRS=

# Hostnames the gateway answers for. Add zuno.chat if its DNS points here
# and the gateway serves the well-known below.
ALLOWED_HOSTS=api.zuno.chat

# One year, once HTTPS is confirmed working end to end.
HSTS_MAX_AGE=31536000

# --- Cloudflare Calls and TURN ------------------------------------------------
CF_CALLS_APP_ID=
CF_CALLS_APP_SECRET=
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# --- Map tiles ----------------------------------------------------------------
# Empty = OSM's public tile server, whose usage policy forbids app traffic at
# scale. Set a commercial or self-hosted source before launch.
TILES_UPSTREAM_URL=
TILES_USER_AGENT=

# --- Self-service registration (gateway POST /register/token) -----------------
# The gateway mints a Synapse registration token and emails it, automating what
# scripts/invite.sh does by hand. Leave disabled to keep invites manual; the
# three values under it are required once it is true.
REGISTRATION_ENABLED=false

# A Synapse admin user's access token: log in as the admin from First deploy
# step 5 and copy it. Used only to mint registration tokens.
SYNAPSE_ADMIN_TOKEN=

# Brevo transactional email: app.brevo.com > SMTP & API > API keys. The sender
# must be an address Brevo has verified for your domain.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Rate limits. Each line shows [gateway default] then the value set here, which
# is deliberately tighter. Empty would fall back to the default.
#
# Read the threat first: an allowed request mints a token AND sends mail to an
# address the caller chose. So this endpoint is an email-sending oracle. The
# per-address limit does nothing against someone varying the address each time
# — only the daily cap and the per-IP limit bound that. The cap is the control
# that actually protects your Brevo bill and your sender reputation.

# Server-wide ceiling, and the most important value here. It is a token bucket,
# not a midnight reset: burst equals the cap and it refills at cap/day, so 100
# means 100 at once and then roughly one every 14 minutes. 0 disables it.
# [500] Raise deliberately for a launch, then put it back.
REGISTRATION_DAILY_CAP=100

# Per client IP. Kept close to the default on purpose: this is a mobile app, and
# carrier NAT puts thousands of real users behind one address, so a tight per-IP
# limit locks out legitimate signups long before it inconveniences an attacker
# with a botnet. 0.1 = one request per 10s after the burst. [0.2 / 3]
REGISTRATION_RATE_LIMIT_RPS=0.1
REGISTRATION_RATE_LIMIT_BURST=3

# Per email address, keyed by a hash of it. One address only ever needs one
# token; the burst covers "it went to spam, send again". 0.000139 = 1 per 2h.
# [1/3600 = 0.000278 / 3]
REGISTRATION_EMAIL_RATE_LIMIT_RPS=0.000139
REGISTRATION_EMAIL_RATE_LIMIT_BURST=2

# How long an emailed token stays valid. People act on a signup mail in minutes,
# so a day is a wide window on an inbox you do not control. 1h is the floor.
# [24h]
REGISTRATION_TOKEN_TTL=4h

# Optional, no security bearing. Empty uses the gateway's default, in brackets.
#   BREVO_SENDER_NAME [Zuno]   BREVO_TEMPLATE_ID [0 = built-in body]
BREVO_SENDER_NAME=
BREVO_TEMPLATE_ID=

# --- Gateway tuning -----------------------------------------------------------
# Enrollment: POST /calls/enroll trades a Matrix access token for a device-bound
# gateway token, which then authenticates /calls, /turn and /tiles by a local
# hash lookup — no Synapse round trip per request.
#
# The TTL is the remote-logout window, and that is the whole point of it. A
# device logged out elsewhere never revokes, and the gateway holds no Matrix
# credential to re-check, so it keeps calling access until its token expires.
# 1h instead of the default 4h cuts that window fourfold. The cost is one extra
# Synapse whoami per calling device per TTL, and it is bounded by how often a
# device actually calls, not by the TTL — a device that stops calling stops
# enrolling. Expiry mid-call is safe: the client re-enrolls once on a 401.
# Minimum 5m, and the client treats a token as expired a minute early. [4h]
ENROLL_TOKEN_TTL=1h

# Per Matrix user, on top of the per-IP limit — so unlike the registration
# limits, carrier NAT does not concentrate unrelated users into one bucket.
# Keep the burst generous: a gateway restart empties the token store, so every
# active device of a user re-enrolls at once, and 5 covers a heavy multi-device
# user. The floor is 2 (two quick enrollments from one device must both pass).
# At a 1h TTL a 5-device user needs ~0.0014/s sustained, so 0.05 leaves ~36x
# headroom while halving what a compromised account can spend on whoami calls.
# [0.1 / 10]
ENROLL_RATE_LIMIT_RPS=0.05
ENROLL_RATE_LIMIT_BURST=5

# Transport and shutdown. No security bearing; empty uses the default.
#   PROXY_IDLE_CONN_TIMEOUT [90s]        upstream keep-alive to Synapse
#   PROXY_MAX_IDLE_CONNS_PER_HOST [256]
#   SHUTDOWN_GRACE_PERIOD [30s]          keep below the gateway's
#                                        stop_grace_period in docker-compose.yml
PROXY_IDLE_CONN_TIMEOUT=
PROXY_MAX_IDLE_CONNS_PER_HOST=
SHUTDOWN_GRACE_PERIOD=

# --- Monitoring (COMPOSE_PROFILES includes monitoring) ------------------------
# Prometheus, Grafana and synapse-usage-exporter (usage totals; it has no
# settings here). No host exporters, no log collection and no error tracker run
# in this stack (README.md, Monitoring).
# Generate: openssl rand -hex 32
GRAFANA_ADMIN_PASSWORD=

# Alerts go to this ntfy topic. No query string. On ntfy.sh anyone who knows a
# topic's name can read it: use a long random name, or a token for a reserved
# topic.
NTFY_URL=https://ntfy.sh/zuno-alerts-CHANGE_ME
NTFY_TOKEN=

# Sentry-protocol DSNs for Synapse and Sygnal. Nothing in this stack receives
# them: leave both empty unless you point them at an external tracker.
SYNAPSE_SENTRY_DSN=
SYGNAL_SENTRY_DSN=
